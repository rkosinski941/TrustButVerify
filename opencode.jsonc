{
  "$schema": "https://opencode.ai/config.json",
  // TrustButVerify example OpenCode config (V1 permission map).
  // Tested against OpenCode 1.19.6. Last matching rule wins, as in the
  // current docs (https://opencode.ai/docs/permissions/) and GitHub
  // issues 24335 and 37935: catch-all first, exact bare allows next,
  // then "git diff *" / "git log *" as ask, then denies last.
  //
  // Suggested: set "model" and "small_model" to a provider you trust.
  // This example does not set them, so OpenCode keeps its own default.
  // This kit is model-agnostic. Prefer a model you trust; some
  // coding-agent setups have been reported to dump environment
  // variables or misuse API keys.
  //
  // These patterns match command text only. Do not use wildcard allows
  // such as "ls *": they would allow "ls foo; <anything>". A script the
  // model writes and then runs can still get past a deny list. The real
  // control is that most shell commands ask first -- read every approval
  // prompt. permission.read stays allow-by-default, with secret-path
  // denies last; that is not secret containment.
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "ls": "allow",
      "dir": "allow",
      "pwd": "allow",
      "git diff *": "ask",
      "git log *": "ask",
      "*--remote-debugging*": "deny",
      "*remote-debugging*": "deny",
      "*9222*": "deny",
      "*9229*": "deny",
      "*9239*": "deny",
      "*json/list*": "deny",
      "*json/version*": "deny",
      "*devtools*": "deny",
      "*DevTools*": "deny",
      "*127.0.0.1:*": "deny",
      "*localhost:*": "deny",
      "*localhost.*": "deny",
      "*0.0.0.0:*": "deny",
      "*127.*": "deny",
      "*::1*": "deny",
      "*0x7f000001*": "deny",
      "*2130706433*": "deny",
      "*0177.*": "deny",
      "*::ffff:127.*": "deny",
      "*::ffff:7f00:*": "deny",
      "*ws://*": "deny",
      "*WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS*": "deny",
      "winget *": "deny",
      "*winget install*": "deny",
      "*winget.exe install*": "deny",
      "choco *": "deny",
      "*choco install*": "deny",
      "scoop install*": "deny",
      "*scoop install*": "deny",
      "npm install -g*": "deny",
      "*npm i -g*": "deny",
      "*npm install --global*": "deny",
      "pip install*": "deny",
      "*pip install*": "deny",
      "*pip3 install*": "deny",
      "*py -m pip install*": "deny",
      "*python -m pip install*": "deny",
      "*Login Data*": "deny",
      "*Cookies*": "deny",
      "*cookies*": "deny",
      "*cmdkey*": "deny",
      "*vaultcmd*": "deny",
      "*gh auth*": "deny",
      "*.env*": "deny",
      "*config.toml*": "deny",
      "*.ssh*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*EBWebView*": "deny",
      "*credential*": "deny",
      "*Credential*": "deny",
      "*.git-credentials*": "deny",
      "*.npmrc*": "deny",
      "*User Data*": "deny",
      "*Local State*": "deny",
      "*hosts.yml*": "deny",
      "*schtasks*": "deny",
      "*Register-ScheduledTask*": "deny",
      "*reg add*": "deny",
      "*reg.exe add*": "deny",
      "*Startup*": "deny",
      "*startup*": "deny",
      "*CurrentVersion\\Run*": "deny",
      "*New-ItemProperty*": "deny",
      "*Set-ItemProperty*": "deny",
      "curl *": "deny",
      "*curl *": "deny",
      "*curl.exe*": "deny",
      "wget *": "deny",
      "*wget *": "deny",
      "*Invoke-WebRequest*": "deny",
      "*invoke-webrequest*": "deny",
      "iwr *": "deny",
      "*iwr *": "deny",
      "*Invoke-RestMethod*": "deny",
      "*invoke-restmethod*": "deny",
      "irm *": "deny",
      "*irm *": "deny",
      "*Net.WebClient*": "deny",
      "*Start-BitsTransfer*": "deny",
      "*certutil*": "deny",
      "*--no-index*": "deny",
      "*auth.json*": "deny",
      "*ConsoleHost_history*": "deny",
      "*.grok*": "deny",
      "*printenv*": "deny",
      "*Get-ChildItem env:*": "deny",
      "*gci env:*": "deny",
      "*dir env:*": "deny",
      "*ls env:*": "deny",
      "*[Environment]::GetEnvironmentVariables*": "deny",
      "*$env:*": "deny",
      "*$\u007Benv:*": "deny",
      "*Get-Item env:*": "deny",
      "*Get-Item Env:*": "deny",
      "*Get-Content env:*": "deny",
      "*Get-Content Env:*": "deny",
      "*gi env:*": "deny",
      "*gc env:*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*Login Data*": "deny",
      "*Cookies*": "deny",
      "*EBWebView*": "deny",
      "*config.toml": "deny",
      "*.ssh*": "deny",
      "*credentials*": "deny",
      "*.git-credentials": "deny",
      "*hosts.yml": "deny",
      "*User Data*": "deny",
      "*auth.json*": "deny",
      "*ConsoleHost_history*": "deny",
      "*.npmrc*": "deny",
      "*.gitconfig*": "deny",
      "*.grok*": "deny",
      "*.aws*": "deny",
      "*.azure*": "deny"
    }
  }
}
